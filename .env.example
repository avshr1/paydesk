# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://paydesk:paydesk@localhost:5432/paydesk"
DIRECT_URL="postgresql://paydesk:paydesk@localhost:5432/paydesk"

APP_URL="http://localhost:3000"

# Auth.js: generate a secret with `npx auth secret`
AUTH_SECRET=""
# Optional: Google login (console.cloud.google.com → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (resend.com → API Keys). EMAIL_FROM must use a domain verified in
# Resend; "Paydesk <onboarding@resend.dev>" works for testing to your own address.
RESEND_API_KEY=""
EMAIL_FROM=""

# Protects the daily overdue-reminder job. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Stripe test mode (dashboard.stripe.com → Developers → API keys). Live keys
# are rejected. The webhook secret comes from `stripe listen` or the
# dashboard's webhook endpoint.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
